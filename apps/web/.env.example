# Aletheia beta licensing. Set real values in Vercel (mark secrets Sensitive), never here.
DATABASE_URL=
LICENSE_SIGNING_KID=
LICENSE_SIGNING_SEED=
RESEND_API_KEY=
LICENSE_EMAIL_FROM=
LICENSE_ADMIN_TOKEN=
CRON_SECRET=

# Aletheia beta access (signed applications).
# Private Vercel Blob store for draft and signed PDFs and audit JSON. Unset in local
# dev: files go to apps/web/.blob-local instead. On Vercel, OIDC with BLOB_STORE_ID also works.
BLOB_READ_WRITE_TOKEN=
# Where the review email (every answer, no PDF) goes when an application is signed. Unset: no review email.
BETA_REVIEW_EMAIL=
# Vercel KMS issuer that seals signed PDFs (separate from the license-signing key). Required in
# production; without it dev and preview seal with an ephemeral key that can't be verified later.
SEAL_KMS_ISSUER_ID=

# Feedback: GitHub App that files issues (PEM private key; \n escapes allowed).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional: raises the GitHub API rate limit when reading releases.
GITHUB_TOKEN=

# MCP server (/mcp). Reuses AUTH0_DOMAIN. The client of the Auth0 API for /mcp that performs
# On-Behalf-Of token exchange to the site API. Unset: only the public tools are served.
MCP_OBO_CLIENT_ID=
MCP_OBO_CLIENT_SECRET=
